        "required": [
          "classId",
          "date",
          "name",
          "timeZone",
          "startsAt",
          "endsAt",
          "bookingClosesAt",
          "durationMinutes",
          "track",
          "coach",
          "capacity",
          "reservedCount",
          "remaining",
          "reservationId",
          "availability",
          "canBook",
          "canCancel",
          "waitlistSupported"
        ],
        "additionalProperties": false
      },
