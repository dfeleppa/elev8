{
  "openapi": "3.1.0",
  "info": {
    "title": "Elev8 member schedule API",
    "version": "0.1.0",
    "description": "Staging-gated addition. Uses an existing exact-one Auth UID link to app_users.id. All four roles may book/cancel only themselves. No waitlist or cancellation deadline. No production enablement. Booking operation IDs are durable per app user; replays never reapply the mutation. Reconcile session, not historical reservationId, after replay."
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "webSession": []
    }
  ],
  "paths": {
    "/api/v1/member/schedule": {
      "get": {
        "operationId": "getMemberSchedule",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "description": "Gym-local date; defaults to today in America/New_York.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Gym day with caller's reservation state only",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleDay"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, UUID or calendar date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "401": {
            "description": "Verified identity or exact-one link missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "403": {
            "description": "Staging gate disabled, forbidden role or browser Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "404": {
            "description": "Occurrence or owned reservation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "409": {
            "description": "Full, closed, invalid DST time or operation ID conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable; outcome may be uncertain. Read current state before retrying the same operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/member/schedule/classes/{classId}": {
      "get": {
        "operationId": "getMemberClass",
        "parameters": [
          {
            "name": "classId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "date",
            "in": "query",
            "description": "Gym-local date; defaults to today in America/New_York.",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Class occurrence",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScheduleDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, UUID or calendar date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "401": {
            "description": "Verified identity or exact-one link missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "403": {
            "description": "Staging gate disabled, forbidden role or browser Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "404": {
            "description": "Occurrence or owned reservation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "409": {
            "description": "Full, closed, invalid DST time or operation ID conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable; outcome may be uncertain. Read current state before retrying the same operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/member/schedule/reservations": {
      "post": {
        "operationId": "bookMemberClass",
        "description": "Reuse operationId after timeout. Same ID with different input returns 409. Already booked returns 200. Full/closed failure is also retained: use a new ID only for a new explicit user action.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Existing booking or replay; session is current state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResult"
                }
              }
            }
          },
          "201": {
            "description": "Booked",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, UUID or calendar date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "401": {
            "description": "Verified identity or exact-one link missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "403": {
            "description": "Staging gate disabled, forbidden role or browser Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "404": {
            "description": "Occurrence or owned reservation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "409": {
            "description": "Full, closed, invalid DST time or operation ID conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable; outcome may be uncertain. Read current state before retrying the same operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/member/schedule/reservations/{reservationId}": {
      "delete": {
        "operationId": "cancelMemberClass",
        "parameters": [
          {
            "name": "reservationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Only the caller's exact reservation ID. Cancellation is allowed after cutoff/start and after a recurrence edit. Retrying a completed operation returns current state; it never deletes a replacement booking.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancellationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Cancelled or replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields, UUID or calendar date",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "401": {
            "description": "Verified identity or exact-one link missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "403": {
            "description": "Staging gate disabled, forbidden role or browser Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "404": {
            "description": "Occurrence or owned reservation not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "409": {
            "description": "Full, closed, invalid DST time or operation ID conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable; outcome may be uncertain. Read current state before retrying the same operation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase access token"
      },
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-next-auth.session-token",
        "description": "NextAuth verified password session; development uses next-auth.session-token. Cookie mutations require the canonical Origin."
      }
    },
