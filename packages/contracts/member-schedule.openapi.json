                    }
                  ]
                },
                "coach": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
                        "name": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "name"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "capacity": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reservedCount": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "remaining": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reservationId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "availability": {
                  "type": "string",
                  "enum": [
                    "available",
                    "full",
                    "closed",
                    "invalid_time"
                  ]
                },
                "canBook": {
                  "type": "boolean"
                },
                "canCancel": {
                  "type": "boolean"
                },
                "waitlistSupported": {
                  "type": "boolean",
                  "const": false
                }
              },
              "required": [
                "classId",
                "date",
                "name",
                "timeZone",
                "startsAt",
                "endsAt",
                "bookingClosesAt",
                "durationMinutes",
                "track",
                "coach",
                "capacity",
                "reservedCount",
                "remaining",
                "reservationId",
                "availability",
                "canBook",
                "canCancel",
                "waitlistSupported"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "date",
          "timeZone",
          "serverNow",
          "sessions"
        ],
        "additionalProperties": false
      },
      "ScheduleDetail": {
        "type": "object",
        "required": [
          "session"
        ],
        "properties": {
          "session": {
            "$ref": "#/components/schemas/ScheduleOccurrence"
          }
        }
      },
      "BookingResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "classId",
          "date",
          "reservationId",
          "session",
          "replayed"
        ],
        "properties": {
          "code": {
            "enum": [
              "booked",
              "already_booked",
              "cancelled"
            ]
          },
          "classId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "reservationId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid",
            "description": "Historical operation result. For current reservation use session.reservationId."
          },
          "session": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ScheduleOccurrence"
              },
              {
                "type": "null"
              }
            ]
          },
          "replayed": {
            "type": "boolean"
          }
        }
      },
      "BookingError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "enum": [
              "unauthorized",
              "forbidden",
              "schedule_disabled",
              "invalid_origin",
              "invalid_input",
              "not_found",
              "full",
              "closed",
              "invalid_time",
              "operation_conflict",
              "unavailable"
            ]
          }
        }
      }
    }
  }
}
