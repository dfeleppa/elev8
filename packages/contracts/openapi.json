{
  "openapi": "3.1.0",
  "info": {
    "title": "Elev8 client API",
    "version": "0.2.0",
    "description": "Foundation: session and admin/owner contacts. Bearer identity must already be linked by supabase_auth_uid. Browser mutations also require matching Origin. Additional CRM and member features are planned separately. Contact detail/edit adds conditional writes without changing list/create or identity behavior."
  },
  "security": [
    {
      "bearerAuth": []
    },
    {
      "webSession": []
    }
  ],
  "paths": {
    "/api/v1/session": {
      "get": {
        "operationId": "getClientSession",
        "responses": {
          "200": {
            "description": "Verified account and capabilities",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSession"
                }
              }
            }
          },
          "401": {
            "description": "Authentication or identity link missing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/crm/contacts": {
      "get": {
        "operationId": "listContacts",
        "description": "Admins and owners only. Stable ascending UUID ordering, up to 50 records per page. Refresh from the first page to see newly added contacts.",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions or invalid browser Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createContact",
        "description": "Admins and owners only. Caller generates an operation UUID and reuses it on retries. A repeated ID yields 409; refresh the directory. Does not create or link login accounts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewContact"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions or invalid browser Origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Operation ID already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Database unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/crm/contacts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "operationId": "getContact",
        "description": "Admins and owners only, through the existing trusted cookie or bearer identity boundary. Direct database access is denied.",
        "responses": {
          "200": {
            "description": "Contact details and current revision",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "ETag": {
                "description": "Strong contact revision tag; send unchanged in If-Match when editing.",
                "schema": {
                  "type": "string",
                  "example": "\"contact:00000000-0000-4000-8000-000000000001:1\""
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactDetailResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID, JSON, fields or precondition syntax",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication or trusted identity link missing",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "403": {
            "description": "CRM capability required, or invalid browser Origin",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "503": {
            "description": "Contact storage unavailable; no internal database details are exposed",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "editContact",
        "description": "Admins and owners only. Cookie writes require matching Origin; bearer authentication takes precedence over cookies. Omitted fields remain unchanged; null clears a channel, and the final record must retain email or phone. A successful PATCH increments revision, including a same-value PATCH. No identity, ownership or membership changes. Stale or uncertain saves require a fresh GET and explicit review, never unconditional retry. Body limit: 16384 UTF-8 bytes.",
        "parameters": [
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "Exactly one strong ETag from GET. Wildcards, weak tags and lists are rejected.",
            "schema": {
              "type": "string",
              "pattern": "^\"contact:[0-9a-f-]{36}:[1-9][0-9]*\"$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved contact and new revision",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              },
              "ETag": {
                "description": "Strong contact revision tag; send unchanged in If-Match when editing.",
                "schema": {
                  "type": "string",
                  "example": "\"contact:00000000-0000-4000-8000-000000000001:1\""
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactDetailResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid ID, JSON, fields or precondition syntax",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "401": {
            "description": "Authentication or trusted identity link missing",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "403": {
            "description": "CRM capability required, or invalid browser Origin",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "412": {
            "description": "Contact revision changed or ETag belongs to another contact; no write",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 16 KiB",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "415": {
            "description": "Content-Type must be application/json",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "428": {
            "description": "If-Match is required",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          },
          "503": {
            "description": "Contact storage unavailable; no internal database details are exposed",
            "headers": {
              "Cache-Control": {
                "description": "Every response is private and must not be stored.",
                "schema": {
                  "type": "string",
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactEditError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Supabase access token"
      },
      "webSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Secure-next-auth.session-token",
        "description": "Existing NextAuth cookie. Development uses next-auth.session-token."
      }
    },
    "schemas": {
      "ClientSession": {
        "type": "object",
        "required": [
          "userId",
          "role",
          "capabilities"
        ],
        "additionalProperties": false,
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "coach",
              "admin",
              "owner"
            ]
          },
          "capabilities": {
            "$ref": "#/components/schemas/Capabilities"
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "member",
          "coaching",
          "crm"
        ],
        "additionalProperties": false,
        "properties": {
          "member": {
            "type": "boolean"
          },
          "coaching": {
            "type": "boolean"
          },
          "crm": {
            "type": "boolean"
          }
        }
      },
      "NewContact": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "full_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "Trimmed before validation."
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email",
                "maxLength": 254
              },
              {
                "const": ""
              }
            ]
          },
          "phone": {
            "type": "string",
            "pattern": "^(\\+[1-9][0-9]{6,14})?$"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "referral",
              "website",
              "import"
            ],
            "default": "manual"
          }
        },
        "anyOf": [
          {
            "required": [
              "email"
            ],
            "properties": {
              "email": {
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "phone"
            ],
            "properties": {
              "phone": {
                "minLength": 1
              }
            }
          }
        ]
      },
      "Contact": {
        "type": "object",
        "required": [
          "id",
          "full_name",
          "email",
          "phone",
          "source",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "full_name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "referral",
              "website",
              "import"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContactPage": {
        "type": "object",
        "required": [
          "contacts",
          "nextCursor"
        ],
        "properties": {
          "contacts": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/Contact"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "ContactResult": {
        "type": "object",
        "required": [
          "contact"
        ],
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/Contact"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "ContactPatch": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "full_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "\\S",
            "description": "Trimmed before length validation."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "format": "email",
            "maxLength": 254,
            "description": "Trimmed and lowercased. Null clears; empty strings are invalid."
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^\\+[1-9][0-9]{6,14}$"
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "referral",
              "website",
              "import"
            ]
          }
        }
      },
      "ContactDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Contact"
          },
          {
            "type": "object",
            "required": [
              "revision",
              "updated_at"
            ],
            "properties": {
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "ContactDetailResult": {
        "type": "object",
        "required": [
          "contact"
        ],
        "additionalProperties": false,
        "properties": {
          "contact": {
            "$ref": "#/components/schemas/ContactDetail"
          }
        }
      },
      "ContactEditError": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "unauthorized",
              "forbidden",
              "invalid_origin",
              "invalid_id",
              "not_found",
              "invalid_patch",
              "channel_required",
              "invalid_precondition",
              "precondition_required",
              "revision_conflict",
              "unsupported_media_type",
              "payload_too_large",
              "unavailable"
            ]
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "full_name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "phone": {
                "type": "string"
              },
              "source": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
